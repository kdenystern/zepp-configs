{
  "configVersion": "v3",
  "app": {
    "appId": 68231,
    "appName": "Launcher",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "kdenys",
    "description": "Nine-tile app launcher, configured from the phone"
  },
  "permissions": [
    "device:os.local_storage",
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.6.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Launcher"
    }
  },
  "defaultLanguage": "en-US"
}
