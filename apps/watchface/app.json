{
  "configVersion": "v3",
  "app": {
    "appId": 68233,
    "appName": "Launcher Face",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "preview.png",
    "vender": "kdenys",
    "description": "Thin-line watch face with a launcher button"
  },
  "permissions": [
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.6.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ],
      "designWidth": 390
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Launcher Face"
    }
  },
  "defaultLanguage": "en-US"
}
