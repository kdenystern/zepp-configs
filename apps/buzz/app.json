{
  "configVersion": "v3",
  "app": {
    "appId": 68237,
    "appName": "Buzz",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "kdenys",
    "description": "Try the watch's vibrations, directly, as notifications and from an alarm"
  },
  "permissions": [
    "device:os.alarm",
    "device:os.notification",
    "device:os.bg_service"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.6.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-service": {
          "services": [
            "app-service/ping"
          ]
        }
      },
      "platforms": [
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Buzz"
    }
  },
  "defaultLanguage": "en-US"
}
